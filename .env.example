# Backend API origin only, without /api/v1 (the OpenAPI paths already include it) and without a trailing slash. https is required except for localhost.
VITE_API_BASE_URL=http://localhost:8000
# Set to "true" to show the API and database health indicator in production builds (always shown in development).
VITE_SHOW_API_STATUS=false
# Google sign in (optional). The OAuth client ID ending in .apps.googleusercontent.com, the same value as the
# backend's GOOGLE_CLIENT_ID. It is a public identifier, not a secret. Leave empty to hide Google sign in.
VITE_GOOGLE_CLIENT_ID=
